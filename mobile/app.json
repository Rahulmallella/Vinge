{
  "expo": {
    "name": "Vinge",
    "slug": "vinge",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vinge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vinge uses your location to find people within your selected dating distance."
        }
      ]
    ]
  }
}
